REGEDIT4

; ============================================
; 1. 注册雅黑字体文件到系统
; ============================================
[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Fonts]
"YaHei Consolas Hybrid (TrueType)"="YaHei-Consolas-Hybrid.ttf"

; ============================================
; 2. 字体一级替补（Windows 标准机制，优先级最高）
; ============================================
[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\FontSubstitutes]

; 核心字体替换
"MS Shell Dlg"="YaHei Consolas Hybrid"
"MS Shell Dlg 2"="YaHei Consolas Hybrid"
"Tahoma"="YaHei Consolas Hybrid"
"Tahoma Bold"="YaHei Consolas Hybrid"
"Arial"="YaHei Consolas Hybrid"
"Arial Black"="YaHei Consolas Hybrid"
"Courier New"="YaHei Consolas Hybrid"
"Times New Roman"="YaHei Consolas Hybrid"
"Verdana"="YaHei Consolas Hybrid"
"Georgia"="YaHei Consolas Hybrid"

; 中文字体替换
"SimSun"="YaHei Consolas Hybrid"
"SimHei"="YaHei Consolas Hybrid"
"NSimSun"="YaHei Consolas Hybrid"
"FangSong"="YaHei Consolas Hybrid"
"KaiTi"="YaHei Consolas Hybrid"
"Microsoft YaHei"="YaHei Consolas Hybrid"
"Microsoft YaHei Bold"="YaHei Consolas Hybrid"
"Microsoft JhengHei"="YaHei Consolas Hybrid"
"MingLiU"="YaHei Consolas Hybrid"
"PMingLiU"="YaHei Consolas Hybrid"

; 日文字体替换
"Meiryo"="YaHei Consolas Hybrid"
"Meiryo Bold"="YaHei Consolas Hybrid"
"MS Gothic"="YaHei Consolas Hybrid"
"MS PGothic"="YaHei Consolas Hybrid"
"MS UI Gothic"="YaHei Consolas Hybrid"

; 符号字体替换
"Webdings"="YaHei Consolas Hybrid"
"Wingdings"="YaHei Consolas Hybrid"
"Symbol"="YaHei Consolas Hybrid"

; ============================================
; 3. Wine 字体替换（供 Wine 内部机制使用）
; ============================================
[HKEY_CURRENT_USER\Software\Wine\Fonts\Replacements]

; 覆盖所有主要需要替换的字体
"MS Shell Dlg"="YaHei Consolas Hybrid"
"MS Shell Dlg 2"="YaHei Consolas Hybrid"
"Tahoma"="YaHei Consolas Hybrid"
"Tahoma Bold"="YaHei Consolas Hybrid"
"Arial"="YaHei Consolas Hybrid"
"Arial Black"="YaHei Consolas Hybrid"
"Courier New"="YaHei Consolas Hybrid"
"Times New Roman"="YaHei Consolas Hybrid"
"Verdana"="YaHei Consolas Hybrid"
"Georgia"="YaHei Consolas Hybrid"
"SimSun"="YaHei Consolas Hybrid"
"SimHei"="YaHei Consolas Hybrid"
"NSimSun"="YaHei Consolas Hybrid"
"Microsoft YaHei"="YaHei Consolas Hybrid"
"Microsoft YaHei Bold"="YaHei Consolas Hybrid"
"Microsoft JhengHei"="YaHei Consolas Hybrid"
"MingLiU"="YaHei Consolas Hybrid"
"PMingLiU"="YaHei Consolas Hybrid"
"Meiryo"="YaHei Consolas Hybrid"
"Meiryo Bold"="YaHei Consolas Hybrid"
"MS Gothic"="YaHei Consolas Hybrid"
"Webdings"="YaHei Consolas Hybrid"
"Wingdings"="YaHei Consolas Hybrid"

; ============================================
; 4. 字体链接（当主字体缺少字形时，从此处找后备字体）
; ============================================
[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\FontLink\SystemLink]

; 让雅黑字体链接到系统自带字体，防止缺字时崩溃
"YaHei Consolas Hybrid"=hex(7):53,00,69,00,6d,00,53,00,75,00,6e,00,2e,00,54,00,\
  54,00,43,00,2c,00,53,00,69,00,6d,00,53,00,75,00,6e,00,00,00,00,00

; 让 Tahoma 等字体链接到雅黑
"Tahoma"=hex(7):59,00,61,00,48,00,65,00,69,00,20,00,43,00,6f,00,6e,00,73,00,6f,\
  00,6c,00,61,00,73,00,20,00,48,00,79,00,62,00,72,00,69,00,64,00,00,00,00,00

"Arial"=hex(7):59,00,61,00,48,00,65,00,69,00,20,00,43,00,6f,00,6e,00,73,00,6f,\
  00,6c,00,61,00,73,00,20,00,48,00,79,00,62,00,72,00,69,00,64,00,00,00,00,00

"Courier New"=hex(7):59,00,61,00,48,00,65,00,69,00,20,00,43,00,6f,00,6e,00,73,\
  00,6f,00,6c,00,61,00,73,00,20,00,48,00,79,00,62,00,72,00,69,00,64,00,00,00,\
  00,00

; ============================================
; 5. 可选配置：优化渲染效果（如果觉得字体模糊可尝试）
; ============================================
[HKEY_CURRENT_USER\Control Panel\Desktop]
; 启用字体平滑 (ClearType)
"FontSmoothing"="2"
"FontSmoothingType"=dword:00000002
; 平滑对比度（默认 1400，可调整为 1200-2200 之间）
"FontSmoothingGamma"=dword:00000578
; 平滑方向（1=水平，0=垂直）
"FontSmoothingOrientation"=dword:00000001

; ============================================
; 6. 可选：禁用 DirectWrite（新程序出现字体问题时可启用）
; ============================================
; [HKEY_CURRENT_USER\Software\Wine\Direct2D]
; "max_version_factory"="0.0"
